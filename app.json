{
  "expo": {
    "name": "Peass",
    "slug": "anx-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pea.png",
    "scheme": "anxapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/pea.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/pea.png",
        "backgroundImage": "./assets/images/pea.png",
        "monochromeImage": "./assets/images/pea.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mank_42.anxapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/pea.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-vector-icons/ionicons",
      ["react-native-android-widget", {
        "widgets": [
          {
            "name": "Hello",
            "label": "My Hello Widget",
            "minWidth": "150dp",
            "minHeight": "150dp",
            "targetCellWidth": 2,
            "targetCellHeight": 2,
            "description": "Tap to open the app",
            "previewImage": "./assets/widget-preview/hello.png"
          }
        ]
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "599143e0-476f-47e4-8b73-0e7a3316280b"
      }
    }
  }
}
